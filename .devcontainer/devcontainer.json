{
  "name": "CIS 531/731 ML Environment",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      "BASE_IMAGE": "${localEnv:DEVCONTAINER_BASE_IMAGE:-pytorch/pytorch:2.2.1-cuda12.1-cudnn8-runtime}"
    }
  },
  "remoteUser": "vscode",
  "hostRequirements": {
    "gpu": "optional"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter"
      ]
    }
  }
}